APP_PORT=8080

POSTGRES_DB=monitoring_service
POSTGRES_USER=monitoring_service
POSTGRES_PASSWORD=monitoring_service_password
POSTGRES_PORT=5432

DATABASE_URL=postgres://monitoring_service:monitoring_service_password@postgres:5432/monitoring_service?sslmode=disable

MIGRATIONS_PATH=migrations
JWT_SECRET=replace-with-a-long-random-secret
TARGET_SESSION_ENCRYPTION_KEY=replace-with-another-base64-encoded-32-byte-key
# Existing installations may retain MONITOR_AUTHORIZATION_ENCRYPTION_KEY as a
# fallback when TARGET_SESSION_ENCRYPTION_KEY is unset. Do not rotate saved keys.

REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

RABBITMQ_URL=amqp://monitoring_service:monitoring_service_password@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=monitoring_service
RABBITMQ_DEFAULT_PASS=monitoring_service_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

OUTBOX_POLL_INTERVAL=1s
OUTBOX_LEASE_DURATION=30s

IDEMPOTENCY_CLEANUP_CRON_SCHEDULE=0 0 * * *
IDEMPOTENCY_KEY_TTL=1h

TELEGRAM_BOT_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_PASSWORD=
SMTP_NAME=
SMTP_FROM=

GRAFANA_PORT=3001
# Monitoring business runtime; extraction is served by the pinned GHCR stack.
MONITOR_INTERVAL=10m
MONITOR_SCHEDULER_POLL=1s
MONITOR_WORKER_LEASE=330s
MONITOR_CLEANUP_INTERVAL=24h

# Bootstrap administrator, used once by migration 24. Reruns do not reset it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Monitoring-Service client identity. Compose supplies the in-container certificate paths.
FETCHER_ADDRESS=fetcher:8443
FETCHER_SERVER_NAME=fetcher
FETCHER_CERT_DIR=./tmp/fetcher-certs
FETCHER_CA_FILE=./tmp/fetcher-certs/ca.pem
FETCHER_CLIENT_CERT_FILE=./tmp/fetcher-certs/monitoring.pem
FETCHER_CLIENT_KEY_FILE=./tmp/fetcher-certs/monitoring.key
FETCHER_ADMIN_TELEGRAM_CHAT_IDS=

# Internal stack credentials; Node/Browserless ports are not published.
BROWSERLESS_TOKEN=replace-with-a-long-random-token
BROWSER_TIMEZONE=UTC
BROWSER_LANGUAGES=ru-RU,ru

# Build-only GO_MODULE_GITHUB_TOKEN comes from the invoking shell or tools/build-go.ps1.
# Do not put it in .env: env_file is passed to runtime services.
